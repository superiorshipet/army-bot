APP_ENV=local
LOG_LEVEL=info

TELEGRAM_BOT_TOKEN=
SUPER_ADMIN_TELEGRAM_IDS=123456789

DATABASE_URL=sqlite+aiosqlite:////tmp/army_bot.db

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

WORKSPACE_ROOT=/tmp/army-bot-workspaces
PUBLIC_BASE_URL=https://awarded-guy-cake-treasury.trycloudflare.com

# Execution mode:
# dry_run: plan only (no server changes)
# local: run local build commands
# ai: AI agent deploys via SSH using the selected AI provider
EXECUTION_MODE=dry_run

AI_PROVIDER=gemini

# Gemini AI settings (required when EXECUTION_MODE=ai)
# Get your key from https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Groq AI settings (set AI_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

AI_MAX_COMMANDS=50
AI_COMMAND_TIMEOUT=120
